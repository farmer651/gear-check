# 复制成 .env.local 再填自己的密钥（不要提交 .env.local）
#
# LLM_PROVIDER 可选：tokenhub | hunyuan | deepseek | moonshot | zhipu | dashscope | siliconflow | openai
# 选了 provider 就不用写 BASE_URL / MODEL（预设里都有），写了的会覆盖预设。
LLM_PROVIDER=tokenhub
LLM_API_KEY=sk-你的密钥
# LLM_MODEL=hy3
# LLM_BASE_URL=https://tokenhub-intl.tencentmaas.com/v1

# 推理模型（如混元 hy3）会先输出思考内容，思考也占 token，3000 起步比较稳
CHAT_MAX_TOKENS=3000

# 允许前端选择的模型白名单，逗号分隔（默认只允许 LLM_MODEL）
# CHAT_MODELS=hy3

# 额外放行的调用来源（默认同源 + localhost 已放行）
# ALLOW_ORIGINS=https://your-app.vercel.app
